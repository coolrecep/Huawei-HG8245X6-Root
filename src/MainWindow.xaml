                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="0" Width="12" Height="12" Margin="7,0,4,0" VerticalAlignment="Center">
