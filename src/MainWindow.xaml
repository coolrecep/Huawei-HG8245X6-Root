                                    <CheckBox x:Name="PaketTestiCheck" Content="Bütünlük Testi Modu (Simülasyon — Değişiklik Yapılmaz)" Margin="0,0,20,4" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"
                                              ToolTip="Konfigürasyon XML içeriğini değiştirmeden şifreler ve flash yazma testini simüle eder. Amaç: Paketleme formatının cihaz tarafından kabul edildiğini doğrulamaktır."/>
                                    <CheckBox x:Name="HesapTemizleCheck" Content="İşlem Tamamlandığında Servis Hesaplarını Temizle" Margin="0,0,0,4" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" IsChecked="True"
                                              ToolTip="İşlem başarıyla tamamlandığında, aktarım için açılan SFTP/SMB kullanıcı hesaplarını otomatik olarak kapatır ve temizler."/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
