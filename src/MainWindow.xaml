            <!-- TR-069 -->
            <TabItem Header="TR-069">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Uzaktan yönetim durumu">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Label Grid.Row="0" Content="CWMP açık mı:"/>           <TextBox Grid.Row="0" Grid.Column="1" x:Name="Tr069Cwmp" IsReadOnly="True"/>
                                <Label Grid.Row="1" Content="Periyodik bildirim:"/>     <TextBox Grid.Row="1" Grid.Column="1" x:Name="Tr069Periodic" IsReadOnly="True"/>
                                <Label Grid.Row="2" Content="ACS URL:"/>                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Tr069Acs" IsReadOnly="True"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Değiştir (seç ve uygula)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="CWMP durumu:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Tr069CwmpSel" SelectedIndex="0">
                                    <ComboBoxItem Content="Kapalı (önerilen)"/>
                                    <ComboBoxItem Content="Açık"/>
                                </ComboBox>
                                <Label Grid.Row="1" Grid.Column="0" Content="Periyodik bildirim:"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Tr069PeriodicSel" SelectedIndex="0">
                                    <ComboBoxItem Content="Kapalı (önerilen)"/>
                                    <ComboBoxItem Content="Açık"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Tr069Btn" Content="Seçimi uygula" Width="130" HorizontalAlignment="Left"
                                    Click="Tr069_Click" IsEnabled="False"
                                    ToolTip="Seçilen CWMP ve periyodik bildirim durumlarını cihaza kaydeder."/>
                            <Button x:Name="Tr069OffBtn" Content="TR-069'u kapat" Width="130" Margin="6,0,0,0"
                                    Click="Tr069Off_Click" IsEnabled="False" Style="{StaticResource GhostButton}"
                                    ToolTip="TR-069 uzaktan yönetimini tamamen kapatır; servis sağlayıcının habersiz ayar değiştirmesini veya firmware basmasını engeller."/>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="Not: Operatör uzaktan desteği ve otomatik firmware güncellemeleri de durur."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- YEDEKLEME -->
            <TabItem Header="Yedekle / Geri Yükle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="Yedek kapsamı (seçtikleriniz kaydedilir/geri yüklenir)">
                            <StackPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="CbWifi"      Content="WiFi (SSID + parola)"  IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="CbDns"       Content="DNS"                   IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="CbTr069"     Content="TR-069"               IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="CbGuvenlik"  Content="Güvenlik + ALG"       IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="CbWan"       Content="WAN / PPPoE bilgisi"  IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="CbCihaz"     Content="Cihaz bilgisi"        IsChecked="True" Margin="0,0,18,6"/>
                                </WrapPanel>
                                <TextBlock Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Not: WAN/PPPoE ve cihaz bilgisi yalnızca kaydedilir (bilgi amaçlı); geri yüklemede yazılmaz."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Yedek al">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BackupProfileBtn" Content="Seçili ayarları yedekle (JSON)" Width="212"
                                            Click="BackupProfile_Click" IsEnabled="False"
                                            ToolTip="Seçili ayarları bilgisayarınıza JSON formatında bir profil dosyası olarak kaydeder."/>
                                    <Button x:Name="BackupDeviceBtn" Content="Cihazın tam yedeğini indir" Width="196" Margin="6,0,0,0"
                                            Click="BackupDevice_Click" IsEnabled="False" Style="{StaticResource GhostButton}"
                                            ToolTip="Modemin resmi .cfg tüm-ayar yedeğini doğrudan cihaz arayüzünden indirir."/>
                                </StackPanel>
                                <TextBlock x:Name="BackupNote" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="JSON yedek: seçili ayarları okur, geri yüklerken adım adım doğrular. Cihaz yedeği: modem'in kendi tüm-ayar dosyası."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Yedekten geri yükle">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RestoreProfileBtn" Content="JSON profilden geri yükle" Width="190"
                                            Click="RestoreProfile_Click" IsEnabled="False"
                                            ToolTip="Daha önce kaydedilmiş JSON profil dosyasındaki ayarları modeme sırayla yazar ve doğrular."/>
                                    <Button x:Name="RestoreDeviceBtn" Content="Cihaz yedeğini geri yükle" Width="190" Margin="6,0,0,0"
                                            Click="RestoreDevice_Click" IsEnabled="False" Style="{StaticResource GhostButton}"
                                            ToolTip="Daha önce indirilmiş resmi .cfg yedek dosyasını modeme yükler ve cihazı yeniden başlatır."/>
                                </StackPanel>
                                <TextBlock x:Name="RestoreInfo" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Geri yüklemeden önce profil/cihaz yedeği seçilir; her adım cihazdan geri okunarak doğrulanır."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- LOG -->
            <TabItem Header="Log">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="8,5" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Label Content="Göster:"/>
                                <ComboBox x:Name="LogFiltre" Width="132" SelectedIndex="1" SelectionChanged="LogFiltre_Changed">
                                    <ComboBoxItem Content="Tümü"/>
                                    <ComboBoxItem Content="Yalnız önemli"/>
                                    <ComboBoxItem Content="Yalnız sorunlar"/>
                                </ComboBox>
                                <CheckBox x:Name="LogOtoKaydir" Content="Otomatik kaydır" IsChecked="True"
                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="LogZaman" Content="Zaman damgası" IsChecked="True"
                                          Margin="12,0,0,0" VerticalAlignment="Center" Click="LogZaman_Click"/>
                                <TextBlock x:Name="LogOzet" Foreground="{StaticResource FgDim}" Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="LogKaydetBtn" Content="Logu kaydet" Width="106" Click="LogKaydet_Click"
                                        ToolTip="Log ekranındaki tüm satırları masaüstünüze metin dosyası (.txt) olarak kaydeder."/>
                                <Button x:Name="LogKopyalaBtn" Content="Kopyala" Width="78" Margin="6,0,0,0"
                                        Click="LogKopyala_Click" Style="{StaticResource GhostButton}"
                                        ToolTip="Tüm log içeriğini panoya kopyalar."/>
                                <Button x:Name="LogTemizleBtn" Content="Temizle" Width="78" Margin="6,0,0,0"
                                        Click="LogTemizle_Click" Style="{StaticResource GhostButton}"
                                        ToolTip="Log ekranındaki tüm satırları temizler."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <RichTextBox x:Name="Log" Margin="0" FontFamily="Consolas" FontSize="11"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="#111" Foreground="#DDD" BorderThickness="0"
                                 IsUndoEnabled="False"/>
                </DockPanel>
            </TabItem>

            <!-- HAKKINDA -->
            <TabItem Header="Hakkında">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Huawei LG8245X6-50 Üst Başlık / Modem Logo Kartı -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,2,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Huawei 8-Yapraklı Logo (#57B6F1 - Modem Web Arayüzü Orijinal Tonu) -->
                                        <Viewbox Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="M3.67 6.14S1.82 7.91 1.72 9.78v0.35c0.08 1.51 1.22 2.4 1.22 2.4 1.83 1.79 6.26 4.04 7.3 4.55 0 0 0.06 0.03 0.1 -0.01l0.02 -0.04v-0.04C7.52 10.8 3.67 6.14 3.67 6.14zM9.65 18.6c-0.02 -0.08 -0.1 -0.08 -0.1 -0.08l-7.38 0.26c0.8 1.43 2.15 2.53 3.56 2.2 0.96 -0.25 3.16 -1.78 3.88 -2.3 0.06 -0.05 0.04 -0.09 0.04 -0.09zm0.08 -0.78C6.49 15.63 0.21 12.28 0.21 12.28c-0.15 0.46 -0.2 0.9 -0.21 1.3v0.07c0 1.07 0.4 1.82 0.4 1.82 0.8 1.69 2.34 2.2 2.34 2.2 0.7 0.3 1.4 0.31 1.4 0.31 0.12 0.02 4.4 0 5.54 0 0.05 0 0.08 -0.05 0.08 -0.05v-0.06c0 -0.03 -0.03 -0.05 -0.03 -0.05zM9.06 3.19a3.42 3.42 0 0 0 -2.57 3.15v0.41c0.03 0.6 0.16 1.05 0.16 1.05 0.66 2.9 3.86 7.65 4.55 8.65 0.05 0.05 0.1 0.03 0.1 0.03a0.1 0.1 0 0 0 0.06 -0.1c1.06 -10.6 -1.11 -13.42 -1.11 -13.42 -0.32 0.02 -1.19 0.23 -1.19 0.23zm8.299 2.27s-0.49 -1.8 -2.44 -2.28c0 0 -0.57 -0.14 -1.17 -0.22 0 0 -2.18 2.81 -1.12 13.43 0.01 0.07 0.06 0.08 0.06 0.08 0.07 0.03 0.1 -0.03 0.1 -0.03 0.72 -1.03 3.9 -5.76 4.55 -8.64 0 0 0.36 -1.4 0.02 -2.34zm-2.92 13.07s-0.07 0 -0.09 0.05c0 0 -0.01 0.07 0.03 0.1 0.7 0.51 2.85 2 3.88 2.3 0 0 0.16 0.05 0.43 0.06h0.14c0.69 -0.02 1.9 -0.37 3 -2.26l-7.4 -0.25zm7.83 -8.41c0.14 -2.06 -1.94 -3.97 -1.94 -3.98 0 0 -3.85 4.66 -6.67 10.8 0 0 -0.03 0.08 0.02 0.13l0.04 0.01h0.06c1.06 -0.53 5.46 -2.77 7.28 -4.54 0 0 1.15 -0.93 1.21 -2.42zm1.52 2.14s-6.28 3.37 -9.52 5.55c0 0 -0.05 0.04 -0.03 0.11 0 0 0.03 0.06 0.07 0.06 1.16 0 5.56 0 5.67 -0.02 0 0 0.57 -0.02 1.27 -0.29 0 0 1.56 -0.5 2.37 -2.27 0 0 0.73 -1.45 0.17 -3.14z"
                                                  Fill="#57B6F1" Stretch="Uniform"/>
                                        </Viewbox>
                                        <!-- 4 Antenli LG8245X6-50 Modem İkonu -->
                                        <Viewbox Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Canvas Width="52" Height="44">
                                                <Line X1="9" Y1="26" X2="7" Y2="3" Stroke="#57B6F1" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
