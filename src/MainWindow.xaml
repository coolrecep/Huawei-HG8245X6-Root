<Window x:Class="HekzOntRace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HekzOntRace v2.0.1 — Huawei LG8245X6-50 / HG8245X6 Tool"
        Height="600" Width="1000" MinWidth="1000" MinHeight="600"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        ToolTipService.ShowDuration="25000"
        ToolTipService.InitialShowDelay="300">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootWindowBorder" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <!-- ÖZEL TEMA UYUMLU BAŞLIK ÇUBUĞU (TITLE BAR) -->
            <Border DockPanel.Dock="Top" Height="32" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: İkon + Başlık -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="11,0,0,0">
                        <Rectangle Width="16" Height="16" Fill="{StaticResource HekzLogoBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TitleBarMainText" Text="HekzOntRace v2.0.1" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/>
                        <TextBlock Text="—" FontSize="11.5" Foreground="{StaticResource FgOff}" VerticalAlignment="Center" Margin="6,0"/>
                        <Viewbox Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Path Data="M3.67 6.14S1.82 7.91 1.72 9.78v0.35c0.08 1.51 1.22 2.4 1.22 2.4 1.83 1.79 6.26 4.04 7.3 4.55 0 0 0.06 0.03 0.1 -0.01l0.02 -0.04v-0.04C7.52 10.8 3.67 6.14 3.67 6.14zM9.65 18.6c-0.02 -0.08 -0.1 -0.08 -0.1 -0.08l-7.38 0.26c0.8 1.43 2.15 2.53 3.56 2.2 0.96 -0.25 3.16 -1.78 3.88 -2.3 0.06 -0.05 0.04 -0.09 0.04 -0.09zm0.08 -0.78C6.49 15.63 0.21 12.28 0.21 12.28c-0.15 0.46 -0.2 0.9 -0.21 1.3v0.07c0 1.07 0.4 1.82 0.4 1.82 0.8 1.69 2.34 2.2 2.34 2.2 0.7 0.3 1.4 0.31 1.4 0.31 0.12 0.02 4.4 0 5.54 0 0.05 0 0.08 -0.05 0.08 -0.05v-0.06c0 -0.03 -0.03 -0.05 -0.03 -0.05zM9.06 3.19a3.42 3.42 0 0 0 -2.57 3.15v0.41c0.03 0.6 0.16 1.05 0.16 1.05 0.66 2.9 3.86 7.65 4.55 8.65 0.05 0.05 0.1 0.03 0.1 0.03a0.1 0.1 0 0 0 0.06 -0.1c1.06 -10.6 -1.11 -13.42 -1.11 -13.42 -0.32 0.02 -1.19 0.23 -1.19 0.23zm8.299 2.27s-0.49 -1.8 -2.44 -2.28c0 0 -0.57 -0.14 -1.17 -0.22 0 0 -2.18 2.81 -1.12 13.43 0.01 0.07 0.06 0.08 0.06 0.08 0.07 0.03 0.1 -0.03 0.1 -0.03 0.72 -1.03 3.9 -5.76 4.55 -8.64 0 0 0.36 -1.4 0.02 -2.34zm-2.92 13.07s-0.07 0 -0.09 0.05c0 0 -0.01 0.07 0.03 0.1 0.7 0.51 2.85 2 3.88 2.3 0 0 0.16 0.05 0.43 0.06h0.14c0.69 -0.02 1.9 -0.37 3 -2.26l-7.4 -0.25zm7.83 -8.41c0.14 -2.06 -1.94 -3.97 -1.94 -3.98 0 0 -3.85 4.66 -6.67 10.8 0 0 -0.03 0.08 0.02 0.13l0.04 0.01h0.06c1.06 -0.53 5.46 -2.77 7.28 -4.54 0 0 1.15 -0.93 1.21 -2.42zm1.52 2.14s-6.28 3.37 -9.52 5.55c0 0 -0.05 0.04 -0.03 0.11 0 0 0.03 0.06 0.07 0.06 1.16 0 5.56 0 5.67 -0.02 0 0 0.57 -0.02 1.27 -0.29 0 0 1.56 -0.5 2.37 -2.27 0 0 0.73 -1.45 0.17 -3.14z"
                                  Fill="#57B6F1" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock x:Name="TitleBarSubText" Text="Huawei LG8245X6-50 / HG8245X6 Tool" FontSize="11" Foreground="{StaticResource FgDim}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sağ: Pencere Kontrol Butonları (Küçült / Büyüt / Kapat) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click" ToolTip="Simge Durumuna Küçült">
                            <Path Data="M 0,5 L 10,5" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" SnapsToDevicePixels="True"/>
                        </Button>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreWindow_Click" ToolTip="Ekranı Kapla">
                            <Path x:Name="MaxRestoreIcon" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" SnapsToDevicePixels="True"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseWindow_Click" ToolTip="Kapat">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" SnapsToDevicePixels="True"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel LastChildFill="True" Margin="8">
                <!-- ÜST ŞERİT: logo + başlık + IP + giriş -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" CornerRadius="6" Padding="9" Margin="0,0,0,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- vektörel logo (XAML drawing brush) -->
                <Rectangle Grid.Column="0" Width="34" Height="34" Fill="{StaticResource HekzLogoBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="HekzOntRace" FontSize="15" FontWeight="Bold"/>
                        <Border x:Name="LiteBadge" Background="{StaticResource AccentLo}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="LITE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHi}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                        <Viewbox Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Path Data="M3.67 6.14S1.82 7.91 1.72 9.78v0.35c0.08 1.51 1.22 2.4 1.22 2.4 1.83 1.79 6.26 4.04 7.3 4.55 0 0 0.06 0.03 0.1 -0.01l0.02 -0.04v-0.04C7.52 10.8 3.67 6.14 3.67 6.14zM9.65 18.6c-0.02 -0.08 -0.1 -0.08 -0.1 -0.08l-7.38 0.26c0.8 1.43 2.15 2.53 3.56 2.2 0.96 -0.25 3.16 -1.78 3.88 -2.3 0.06 -0.05 0.04 -0.09 0.04 -0.09zm0.08 -0.78C6.49 15.63 0.21 12.28 0.21 12.28c-0.15 0.46 -0.2 0.9 -0.21 1.3v0.07c0 1.07 0.4 1.82 0.4 1.82 0.8 1.69 2.34 2.2 2.34 2.2 0.7 0.3 1.4 0.31 1.4 0.31 0.12 0.02 4.4 0 5.54 0 0.05 0 0.08 -0.05 0.08 -0.05v-0.06c0 -0.03 -0.03 -0.05 -0.03 -0.05zM9.06 3.19a3.42 3.42 0 0 0 -2.57 3.15v0.41c0.03 0.6 0.16 1.05 0.16 1.05 0.66 2.9 3.86 7.65 4.55 8.65 0.05 0.05 0.1 0.03 0.1 0.03a0.1 0.1 0 0 0 0.06 -0.1c1.06 -10.6 -1.11 -13.42 -1.11 -13.42 -0.32 0.02 -1.19 0.23 -1.19 0.23zm8.299 2.27s-0.49 -1.8 -2.44 -2.28c0 0 -0.57 -0.14 -1.17 -0.22 0 0 -2.18 2.81 -1.12 13.43 0.01 0.07 0.06 0.08 0.06 0.08 0.07 0.03 0.1 -0.03 0.1 -0.03 0.72 -1.03 3.9 -5.76 4.55 -8.64 0 0 0.36 -1.4 0.02 -2.34zm-2.92 13.07s-0.07 0 -0.09 0.05c0 0 -0.01 0.07 0.03 0.1 0.7 0.51 2.85 2 3.88 2.3 0 0 0.16 0.05 0.43 0.06h0.14c0.69 -0.02 1.9 -0.37 3 -2.26l-7.4 -0.25zm7.83 -8.41c0.14 -2.06 -1.94 -3.97 -1.94 -3.98 0 0 -3.85 4.66 -6.67 10.8 0 0 -0.03 0.08 0.02 0.13l0.04 0.01h0.06c1.06 -0.53 5.46 -2.77 7.28 -4.54 0 0 1.15 -0.93 1.21 -2.42zm1.52 2.14s-6.28 3.37 -9.52 5.55c0 0 -0.05 0.04 -0.03 0.11 0 0 0.03 0.06 0.07 0.06 1.16 0 5.56 0 5.67 -0.02 0 0 0.57 -0.02 1.27 -0.29 0 0 1.56 -0.5 2.37 -2.27 0 0 0.73 -1.45 0.17 -3.14z"
                                  Fill="#57B6F1" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Huawei LG8245X6-50" Foreground="{StaticResource AccentHi}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- giriş alanları -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="122"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="148"/>
                    </Grid.ColumnDefinitions>
                    <Label  Grid.Column="0" Content="Modem adresi:" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" x:Name="InputIp" IsEditable="True" Text="192.168.1.1" Margin="0,0,12,0">
                        <ComboBoxItem Content="192.168.1.1"/>
                        <ComboBoxItem Content="192.168.100.1"/>
                        <ComboBoxItem Content="192.168.0.1"/>
                        <ComboBoxItem Content="192.168.18.1"/>
                    </ComboBox>
                    <Label  Grid.Column="2" Content="Kullanıcı:" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="3" x:Name="InputUser" Text="admin" Margin="0,0,12,0"/>
                    <Label  Grid.Column="4" Content="Şifre:" Margin="0,0,4,0"/>
                    <Border Grid.Column="5" Background="{StaticResource BgInput}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Height="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="12" Height="12" Margin="6,0,4,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#9AA3B5" StrokeThickness="1.6" Fill="Transparent"/>
                                    <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7.5" RadiusX="1.8" RadiusY="1.8" Fill="#9AA3B5"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="9.8" Width="2" Height="2" Fill="#1C2130"/>
                                </Canvas>
                            </Viewbox>
                            <PasswordBox Grid.Column="1" x:Name="InputPassPwd" Style="{StaticResource BarePasswordBox}" PasswordChar="•" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="InputPass" Style="{StaticResource BareSecretTextBox}" Visibility="Collapsed"/>
                            <Button Grid.Column="2" Style="{StaticResource EyeToggleButtonStyle}" Tag="InputPass" Click="ToggleSecret_Click" ToolTip="Şifreyi Göster / Gizle">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="F0 M 1,8 C 2.8,4.2 5.3,2.5 8,2.5 C 10.7,2.5 13.2,4.2 15,8 C 13.2,11.8 10.7,13.5 8,13.5 C 5.3,13.5 2.8,11.8 1,8 Z M 8,5 A 3,3 0 1 0 8,11 A 3,3 0 1 0 8,5 Z M 8,6.4 A 1.6,1.6 0 1 0 8,9.6 A 1.6,1.6 0 1 0 8,6.4 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Başlat / Durdur Tek Dinamik Buton -->
                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="7,0,0,0">
                    <Button x:Name="GoBtn" Content="BAŞLAT" Width="88" Click="Go_Click" IsDefault="True"
                            ToolTip="Modeme bağlanır, fabrika verilerini ve sistem konfigürasyonunu çekerek şifreleri ekrana döker."/>
                    <Button x:Name="StopBtn" Content="DURDUR" Width="88" Visibility="Collapsed"
                            Style="{StaticResource DangerButton}" Click="Stop_Click"
                            ToolTip="Devam eden işlemi iptal eder ve durdurur."/>
                </Grid>
            </Grid>
        </Border>

        <!-- ALT ÇUBUK: faz + progress + kayan yazı -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" CornerRadius="5" Padding="8,4" Margin="0,7,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True" Height="22" VerticalAlignment="Center">
                    <!-- Normal Durum Metni -->
                    <TextBlock x:Name="PhaseText" Text="Hazır" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <!-- Kayan Yazı (Marquee) Alanı -->
                    <Canvas x:Name="MarqueeCanvas" ClipToBounds="True" Height="22" Visibility="Collapsed">
                        <TextBlock x:Name="MarqueeText" Text="" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"
                                   Canvas.Top="2">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="MarqueeTransform" X="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>

                <ProgressBar Grid.Column="1" x:Name="KurulumBar" Height="8" IsIndeterminate="True" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ANA SEKMELER -->
        <TabControl x:Name="MainTabs">

            <!-- SONUÇLAR -->
            <TabItem Header="Sonuçlar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <GroupBox Header="Erişim bilgileri" Margin="0,0,0,10">
                            <Grid Margin="2,4,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="114"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="SSID (gizlenmiş):" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ResSsid" IsReadOnly="True" Height="27" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                <Label Grid.Row="0" Grid.Column="3" Content="WiFi şifresi:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Height="27" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="8,0,5,0" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#9AA3B5" StrokeThickness="1.6" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7.5" RadiusX="1.8" RadiusY="1.8" Fill="#9AA3B5"/>
                                                <Ellipse Canvas.Left="7" Canvas.Top="9.8" Width="2" Height="2" Fill="#1C2130"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBox Grid.Column="1" x:Name="ResWifi" Style="{StaticResource BareSecretTextBox}" IsReadOnly="True"/>
                                        <Button Grid.Column="2" Style="{StaticResource EyeToggleButtonStyle}" Tag="ResWifi" Click="ToggleSecret_Click" ToolTip="Şifreyi Göster / Gizle">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="F0 M 1,8 C 2.8,4.2 5.3,2.5 8,2.5 C 10.7,2.5 13.2,4.2 15,8 C 13.2,11.8 10.7,13.5 8,13.5 C 5.3,13.5 2.8,11.8 1,8 Z M 8,5 A 3,3 0 1 0 8,11 A 3,3 0 1 0 8,5 Z M 8,6.4 A 1.6,1.6 0 1 0 8,9.6 A 1.6,1.6 0 1 0 8,6.4 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <Label Grid.Row="1" Grid.Column="0" Content="Web hesabı:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Height="27" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="8,0,5,0" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#9AA3B5" StrokeThickness="1.6" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7.5" RadiusX="1.8" RadiusY="1.8" Fill="#9AA3B5"/>
                                                <Ellipse Canvas.Left="7" Canvas.Top="9.8" Width="2" Height="2" Fill="#1C2130"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBox Grid.Column="1" x:Name="ResAdmin" Style="{StaticResource BareSecretTextBox}" IsReadOnly="True"/>
                                        <Button Grid.Column="2" Style="{StaticResource EyeToggleButtonStyle}" Tag="ResAdmin" Foreground="{StaticResource AccentHi}" Click="ToggleSecret_Click" ToolTip="Şifreyi Göster / Gizle">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="F0 M 1,8 C 2.8,4.2 5.3,2.5 8,2.5 C 10.7,2.5 13.2,4.2 15,8 C 13.2,11.8 10.7,13.5 8,13.5 C 5.3,13.5 2.8,11.8 1,8 Z M 8,5 A 3,3 0 1 0 8,11 A 3,3 0 1 0 8,5 Z M 8,6.4 A 1.6,1.6 0 1 0 8,9.6 A 1.6,1.6 0 1 0 8,6.4 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Label Grid.Row="1" Grid.Column="3" Content="sUser şifresi:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Height="27" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="8,0,5,0" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#9AA3B5" StrokeThickness="1.6" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7.5" RadiusX="1.8" RadiusY="1.8" Fill="#9AA3B5"/>
                                                <Ellipse Canvas.Left="7" Canvas.Top="9.8" Width="2" Height="2" Fill="#1C2130"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBox Grid.Column="1" x:Name="ResSuser" Style="{StaticResource BareSecretTextBox}" IsReadOnly="True"/>
                                        <Button Grid.Column="2" Style="{StaticResource EyeToggleButtonStyle}" Tag="ResSuser" Foreground="{StaticResource AccentHi}" Click="ToggleSecret_Click" ToolTip="Şifreyi Göster / Gizle">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="F0 M 1,8 C 2.8,4.2 5.3,2.5 8,2.5 C 10.7,2.5 13.2,4.2 15,8 C 13.2,11.8 10.7,13.5 8,13.5 C 5.3,13.5 2.8,11.8 1,8 Z M 8,5 A 3,3 0 1 0 8,11 A 3,3 0 1 0 8,5 Z M 8,6.4 A 1.6,1.6 0 1 0 8,9.6 A 1.6,1.6 0 1 0 8,6.4 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <Label Grid.Row="2" Grid.Column="0" Content="PPPoE kullanıcı:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ResPppoeUser" IsReadOnly="True" Height="27" VerticalContentAlignment="Center" Margin="0,0,0,0"/>
                                <Label Grid.Row="2" Grid.Column="3" Content="PPPoE şifre:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Grid.Row="2" Grid.Column="4" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Height="27" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Width="13" Height="13" Margin="8,0,5,0" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M 5,7 V 5 A 3,3 0 0 1 11,5 V 7" Stroke="#9AA3B5" StrokeThickness="1.6" Fill="Transparent"/>
                                                <Rectangle Canvas.Left="3" Canvas.Top="7" Width="10" Height="7.5" RadiusX="1.8" RadiusY="1.8" Fill="#9AA3B5"/>
