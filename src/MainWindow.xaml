                                                <Line X1="43" Y1="26" X2="45" Y2="3" Stroke="#57B6F1" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Rectangle Canvas.Left="2" Canvas.Top="25" Width="48" Height="16" RadiusX="4" RadiusY="4" Fill="#1C3A5E" Stroke="#57B6F1" StrokeThickness="2"/>
                                                <Ellipse Canvas.Left="9" Canvas.Top="31.5" Width="3.2" Height="3.2" Fill="#3FB97A"/>
                                                <Ellipse Canvas.Left="16" Canvas.Top="31.5" Width="3.2" Height="3.2" Fill="#3FB97A"/>
                                                <Ellipse Canvas.Left="23" Canvas.Top="31.5" Width="3.2" Height="3.2" Fill="#3FB97A"/>
                                                <Ellipse Canvas.Left="30" Canvas.Top="31.5" Width="3.2" Height="3.2" Fill="#57B6F1"/>
                                                <Ellipse Canvas.Left="37" Canvas.Top="31.5" Width="3.2" Height="3.2" Fill="#57B6F1"/>
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Modem Marka / Model Başlığı -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="HUAWEI" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource FgDim}"/>
                                            <TextBlock Text="LG8245X6-50" FontSize="14.5" FontWeight="Bold" Foreground="#57B6F1" Margin="0,-1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock x:Name="AboutToolTitle" Text="Huawei LG8245X6-50 / HG8245X6 ONT &amp; Router Root Aracı" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                                    <TextBlock Text="Huawei OptiXstar / EchoLife Wi-Fi 6 GPON ONT &amp; Router Yönetim Aracı" FontSize="11" Foreground="{StaticResource AccentHi}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource AccentLo}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersionBadge" Text="v2.0.1 Açık Kaynak" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHi}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Desteklenen Modeller ve Kapsam -->
                        <GroupBox Header="Desteklenen Cihazlar ve Kapsam" Margin="0,0,0,10">
                            <StackPanel Margin="2">
                                <TextBlock Text="Bu araç, servis sağlayıcılar (Superonline vb.) tarafından kilitlenen Huawei fiber modem / ONT cihazlarında sUser (yönetici) şifresini okumak, değiştirmek ve PPPoE kullanıcı bilgilerinizi öğrenmek için tasarlanmıştır."
                                           TextWrapping="Wrap" Margin="2,0,2,8" Foreground="{StaticResource Fg}"/>
                                
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol Sütun: Modeller -->
                                    <Border Grid.Column="0" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Uyumlu Modem Modelleri:" FontWeight="Bold" Foreground="{StaticResource AccentHi}" Margin="0,0,0,5"/>
                                            <TextBlock Text="• Huawei LG8245X6-50 / OptiXstar HG8245X6 (Wi-Fi 6 GPON)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Huawei HG8245X6 serisi (HG8245X6-6N / 10 / 8N-30)" Margin="0,0,0,3" Foreground="{StaticResource FgDim}"/>
                                            <TextBlock Text="• Benzer V500R021 yazılımlı Huawei ONT / Router cihazları" Margin="0,0,0,1" Foreground="{StaticResource FgDim}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sağ Sütun: Yetenekler -->
                                    <Border Grid.Column="2" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="Temel Yetenekler:" FontWeight="Bold" Foreground="{StaticResource AccentHi}" Margin="0,0,0,5"/>
                                            <TextBlock Text="✔ Gizlenen sUser yönetici şifresini çözme ve listeleme" Margin="0,0,0,3"/>
                                            <TextBlock Text="✔ Kendi router'ınız için gerekli PPPoE kullanıcı adı/şifresini alma" Margin="0,0,0,3"/>
                                            <TextBlock Text="✔ Fabrika kablosuz ağ (Wi-Fi) şifresi ve SSID bilgilerini okuma" Margin="0,0,0,3"/>
                                            <TextBlock Text="✔ İsteğe bağlı yeni sUser şifresi yazma ve SSH shell açma" Margin="0,0,0,1"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- GNU GPL v2 Lisansı -->
                        <GroupBox Header="Yazılım Lisansı (GNU General Public License v2)" Margin="0,0,0,0">
                            <DockPanel Margin="2">
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                                    <TextBlock Text="Bu yazılım, GNU GPL v2 özgür yazılım lisansı şartları altında dağıtılmaktadır."
                                               Foreground="{StaticResource FgDim}" VerticalAlignment="Center"/>
                                    <Button Content="Lisansı Kopyala" Width="110" Height="24" HorizontalAlignment="Right"
                                            Style="{StaticResource GhostButton}" Click="CopyLicense_Click"
                                            ToolTip="GNU GPL v2 lisans metnini panoya kopyalar."/>
                                </DockPanel>
                                <RichTextBox x:Name="LicenseRichBox" IsReadOnly="True" Focusable="False"
                                             Background="{StaticResource BgInput}" Foreground="{StaticResource Fg}"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             Height="160" Padding="12,8" IsDocumentEnabled="True"/>
                            </DockPanel>
                        </GroupBox>

                        <!-- Yasal ve Teknik Dipnot (Lite Sürüm) -->
                        <Border x:Name="LiteLegalNote" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,10,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                <TextBlock Text="Bu uygulamada üreticiye ait orijinal firmware, yapılandırma dosyaları veya ticari sırlar bulundurmamaktadır. Tüm araçlar, kullanıcının kendi cihazından elde edeceği veriler üzerinde lokal olarak çalışacak şekilde tasarlanmıştır."
                                           FontSize="10.5" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" LineHeight="16"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
