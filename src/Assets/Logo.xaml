<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vector logo: dalga + nokta (modem/fiber esintili) -->
    <DrawingBrush x:Key="HekzLogoBrush" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- arka plan daire -->
                <GeometryDrawing Brush="#0E639C">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="30" RadiusY="30"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 3 kavis (fiber dalgaları) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="3" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M20,40 Q32,24 44,40"/>
                            <PathGeometry Figures="M15,46 Q32,18 49,46"/>
                            <PathGeometry Figures="M25,34 Q32,28 39,34"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Alt nokta -->
                <GeometryDrawing Brush="#FFC857">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,48" RadiusX="3.5" RadiusY="3.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
